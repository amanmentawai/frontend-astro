---
import MainLayout from '../layouts/MainLayout.astro';
import { directus, getDirectusAsset } from '../lib/directus';
import { readItems } from '@directus/sdk';

export const prerender = false;

let daftarBerita = [];
try {
  daftarBerita = await directus.request(
    readItems('artikel_berita', {
      fields: ['id', 'judul', 'status', 'tanggal_publikasi', 'gambar_utama', 'konten', 'link_eksternal'],
      filter: {
        status: {
          _eq: 'published'
        }
      },
      sort: ['-tanggal_publikasi'],
      limit: -1
    })
  );
} catch (error) {
  console.error("Gagal mengambil data Berita:", error);
}
---

<MainLayout title="Berita & Publikasi | AMAN Mentawai">
  <header class="mb-8">
    <span class="text-xs font-bold uppercase tracking-widest text-green-600 bg-green-50 px-3 py-1 rounded-full inline-block mb-3">Pusat Informasi</span>
    <h1 class="text-4xl font-black text-slate-900 tracking-tight">Kabar & Publikasi</h1>
    <p class="text-slate-500 mt-2 max-w-2xl">Ikuti berita terbaru, siaran pers, dan informasi terkini seputar pergerakan masyarakat adat di Mentawai.</p>
  </header>

  <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm mb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1.5 tracking-wider">Cari Judul Berita</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-4 flex items-center text-slate-400"></span>
          <input
            type="text"
            id="search-berita"
            placeholder="Ketik kata kunci berita..."
            class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:bg-white transition-all"
          />
        </div>
      </div>

      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1.5 tracking-wider">Urutan Waktu Publikasi</label>
        <select
          id="sort-berita"
          class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 cursor-pointer font-medium focus:outline-none focus:border-green-500"
        >
          <option value="terbaru">Terbaru Terlebih Dahulu</option>
          <option value="terlama">Terlama Terlebih Dahulu</option>
        </select>
      </div>
    </div>
  </div>

  <div id="grid-berita" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {daftarBerita.map((berita) => {
      const judulAman = berita.judul || 'Tanpa Judul';
      
      let urlFoto = null;
      if (berita.gambar_utama) {
        const fotoId = typeof berita.gambar_utama === 'object' ? berita.gambar_utama.id : berita.gambar_utama;
        urlFoto = getDirectusAsset(fotoId);
      }

      let timestamp = 0;
      let formatWaktu = 'Waktu tidak diketahui';
      if (berita.tanggal_publikasi) {
        const dateObj = new Date(berita.tanggal_publikasi);
        timestamp = dateObj.getTime();
        formatWaktu = dateObj.toLocaleDateString('id-ID', {
          timeZone: 'Asia/Jakarta',
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }

      const kontenHtml = berita.konten || '<p>Tidak ada konten.</p>';
      const cuplikanTeks = kontenHtml.replace(/<[^>]*>?/gm, '').substring(0, 120) + '...';

      return (
        <article 
          class="berita-card bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group"
          data-judul={judulAman.toLowerCase()}
          data-timestamp={timestamp}
        >
          <div class="h-48 w-full overflow-hidden bg-slate-100 relative">
            {urlFoto ? (
              <img src={urlFoto} alt={judulAman} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-300 text-xs font-medium bg-slate-100/50">
                <span class="text-3xl mb-2">📰</span>
                Tanpa Gambar
              </div>
            )}
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-slate-700 text-[10px] font-bold px-3 py-1.5 rounded-full shadow-sm">
              {formatWaktu}
            </div>
          </div>

          <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <h2 class="text-xl font-bold text-slate-800 tracking-tight group-hover:text-green-600 transition-colors leading-snug line-clamp-2">
                {judulAman}
              </h2>
              <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 text-justify">
                {cuplikanTeks}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-50">
              <a 
                href={`/berita/${encodeURIComponent(judulAman)}`}
                class="text-xs font-bold text-green-600 hover:text-green-700 inline-flex items-center justify-center gap-1 cursor-pointer bg-green-50/50 hover:bg-green-50 px-4 py-2.5 rounded-xl transition-colors w-full text-center"
              >
                Baca Selengkapnya
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div id="berita-kosong" class="hidden text-center py-20 bg-white rounded-3xl border border-slate-100 text-slate-400 font-medium mt-6">
    Tidak ada berita yang cocok dengan pencarian.
  </div>
</MainLayout>

<script>
  // PENCARIAN & FILTER SEPERTI SEMULA
  const cards = Array.from(document.querySelectorAll('.berita-card')) as HTMLElement[];
  const container = document.getElementById('grid-berita');
  const pesanKosong = document.getElementById('berita-kosong');
  
  const searchInput = document.getElementById('search-berita') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-berita') as HTMLSelectElement;

  function filterDanUrutkan() {
    const kataKunci = searchInput.value.toLowerCase().trim();
    const urutan = sortSelect.value;
    let adaData = false;

    cards.forEach(card => {
      const judul = card.dataset.judul || '';
      
      if (judul.includes(kataKunci)) {
        card.classList.remove('hidden');
        adaData = true;
      } else {
        card.classList.add('hidden');
      }
    });

    const kartuTerurut = cards.sort((a, b) => {
      const timeA = parseInt(a.dataset.timestamp || '0', 10);
      const timeB = parseInt(b.dataset.timestamp || '0', 10);
      return urutan === 'terbaru' ? timeB - timeA : timeA - timeB;
    });

    container!.innerHTML = '';
    kartuTerurut.forEach(card => container!.appendChild(card));
    pesanKosong?.classList.toggle('hidden', adaData);
  }

  searchInput?.addEventListener('input', filterDanUrutkan);
  sortSelect?.addEventListener('change', filterDanUrutkan);
</script>