---
import MainLayout from '../layouts/MainLayout.astro';

const daftarKomunitas = [
  {
    nama: "Komunitas Adat Uma Siberut",
    wilayah: "Siberut Selatan",
    img: "/images/hero-mentawai.jpg",
    slug: "uma-siberut"
  },
  {
    nama: "Komunitas Sipora Jaya",
    wilayah: "Sipora Utara",
    img: "/images/kantor.jpg",
    slug: "sipora-jaya"
  },
  {
    nama: "Komunitas Pagai Selatan",
    wilayah: "Pagai Selatan",
    img: "/images/hero-mentawai.jpg",
    slug: "pagai-selatan"
  }
];
---

<MainLayout title="Daftar Komunitas Adat | AMAN Mentawai">
  <header class="mb-12">
    <h1 class="text-4xl font-black text-slate-900 mb-4">Daftar Komunitas Adat</h1>
    <p class="text-lg text-slate-600 max-w-2xl leading-relaxed">
      Berikut adalah persebaran komunitas adat di Kepulauan Mentawai yang berada di bawah naungan pendampingan AMAN Wilayah Mentawai.
    </p>
  </header>

  <div class="grid md:grid-cols-3 gap-8">
    {daftarKomunitas.map((item) => (
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
        <div class="h-56 overflow-hidden">
          <img src={item.img} alt={item.nama} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <span class="text-xs font-bold text-green-600 uppercase tracking-widest">{item.wilayah}</span>
          <h3 class="text-xl font-bold text-slate-800 mt-2 mb-4">{item.nama}</h3>
          <p class="text-slate-500 text-sm mb-6 line-clamp-2">
            Masyarakat adat yang menjunjung tinggi kearifan lokal Arat Sabulungan dan perlindungan hutan adat Uma.
          </p>
          <a href={`/komunitas/${item.slug}`} class="block text-center bg-slate-50 hover:bg-green-600 hover:text-white text-green-700 font-bold py-3 rounded-2xl transition-colors">
            Lihat Profil Komunitas
          </a>
        </div>
      </div>
    ))}
  </div>

  <section class="mt-20 bg-green-50 rounded-[2.5rem] p-8 md:p-16 text-center border border-green-100">
    <h2 class="text-3xl font-bold text-green-900 mb-4">Ingin Komunitasmu Terdaftar?</h2>
    <p class="text-green-700 max-w-xl mx-auto mb-8">
      Kami membantu proses pemetaan wilayah adat dan advokasi hukum bagi komunitas adat di seluruh Kepulauan Mentawai.
    </p>
    <a href="mailto:info@amanmentawai.or.id" class="bg-green-700 text-white px-8 py-4 rounded-full font-bold hover:bg-green-800 transition-all inline-block">
      Hubungi Pendamping Kami
    </a>
  </section>
</MainLayout>