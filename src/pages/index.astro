---
import MainLayout from '../layouts/MainLayout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

export const prerender = false;

// 1. Variabel Penampung
let totalKader = "50+";
let totalKomunitas = "10+";
let kegiatanTerbaru = [];
let semuaTestimoni = [];
let testimoniTerbaru = [];

// 2. Ambil Total Kader
try {
  const dataKader = await directus.request(readItems('kader', { fields: ['id'], limit: -1 }));
  if (dataKader) totalKader = dataKader.length;
} catch (error) {
  console.error("Gagal mengambil data Kader:", error.message);
}

// 3. Ambil Total Komunitas
try {
  const dataKomunitas = await directus.request(readItems('komunitas', { fields: ['id'], limit: -1 }));
  if (dataKomunitas) totalKomunitas = dataKomunitas.length;
} catch (error) {
  console.error("Gagal mengambil data Komunitas:", error.message);
}

// 4. Ambil 3 Kegiatan Terbaru
try {
  const dataKegiatan = await directus.request(readItems('kegiatan', {
    fields: ['id', 'judul', 'tanggal_waktu', 'deskripsi'],
    limit: 3
  }));
  if (dataKegiatan && dataKegiatan.length > 0) {
    kegiatanTerbaru = dataKegiatan;
  }
} catch (error) {
  console.error("Gagal mengambil data Kegiatan:", error.message);
}

// 5. Ambil Data Suara Masyarakat (DENGAN SORTING TERBARU)
try {
  const dataTestimoni = await directus.request(readItems('suara_masyarakat', {
    fields: ['id', 'nama', 'peran', 'kutipan'],
    sort: ['-id'], 
    limit: -1 
  }));
  
  if (dataTestimoni && dataTestimoni.length > 0) {
    semuaTestimoni = dataTestimoni;
    testimoniTerbaru = dataTestimoni.slice(0, 3);
  }
} catch (error) {
  console.error("Gagal mengambil data Suara Masyarakat:", error.message);
}

// === DATA DUMMY ===
const fallbackKegiatan = [
  { judul: "Belum Ada Kegiatan", deskripsi: "<p>Data kegiatan belum tersedia dari database.</p>" }
];
const fallbackTestimoni = [
  { nama: "Belum Ada Data", peran: "Sistem", kutipan: "Harap isi collection suara_masyarakat di Directus." }
];

const kegiatanDitampilkan = kegiatanTerbaru.length > 0 ? kegiatanTerbaru : fallbackKegiatan;
const testimoniDitampilkan = testimoniTerbaru.length > 0 ? testimoniTerbaru : fallbackTestimoni;
---

<MainLayout title="Beranda | AMAN Mentawai">
  <section class="relative h-[80vh] w-full rounded-3xl overflow-hidden mb-16 shadow-2xl">
    <img 
      src="/images/hero-mentawai.jpg" 
      class="absolute inset-0 w-full h-full object-cover"
      alt="Masyarakat Adat Mentawai"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/75 to-transparent flex items-center px-8 md:px-16">
      <div class="max-w-2xl text-white">
        <span class="bg-green-500/20 text-green-300 border border-green-500/30 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 inline-block">
          Aliansi Masyarakat Adat Nusantara
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
          AMAN <span class="text-green-400">Mentawai</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-200 mb-8 leading-relaxed">
          Berjuang bersama untuk mewujudkan kedaulatan politik, kemandirian ekonomi, dan martabat budaya masyarakat adat di Kepulauan Mentawai.
        </p>
        <div class="flex flex-wrap gap-4">
            <a href="#tentang-kami" class="bg-green-600 hover:bg-green-700 text-white px-8 py-3.5 rounded-full font-bold transition-all shadow-lg shadow-green-600/30">
              Tentang Kami
            </a>
            <a href="/kegiatan" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-8 py-3.5 rounded-full font-bold transition-all">
              Lihat Kegiatan
            </a>
        </div>
      </div>
    </div>
  </section>

  <section id="tentang-kami" class="grid md:grid-cols-2 gap-12 items-center mb-20 scroll-mt-24">
    <div class="space-y-6">
      <div class="flex items-center gap-2">
        <span class="w-2 h-8 bg-green-500 rounded-full"></span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Tentang Kami</h2>
      </div>
      <p class="text-lg text-slate-600 leading-relaxed text-justify">
        Aliansi Masyarakat Adat Nusantara (AMAN) Daerah Kepulauan Mentawai berdedikasi penuh untuk melakukan pendampingan, penguatan kapasitas kader, serta pengakuan dan perlindungan masyarakat adat di Kepulauan Mentawai. Kami bergerak bersama komunitas adat untuk memastikan hak-hak masyarakat adat Mentawai diakui dan dilindungi.
      </p>
      <p class="text-lg text-slate-600 leading-relaxed text-justify">
        Melalui visi besar mandiri secara ekonomi, bermartabat secara budaya, dan berdaulat secara politik. AMAN Mentawai terus bergerak untuk eksistensi masyarakat adat di Kepulauan Mentawai.
      </p>
    </div>
    <div class="relative group">
      <div class="absolute inset-0 bg-green-600 rounded-3xl rotate-3 scale-95 opacity-20 group-hover:rotate-1 transition-transform duration-300"></div>
      <img 
        src="/images/kantor.jpg" 
        alt="Kantor AMAN Mentawai" 
        class="relative rounded-3xl object-cover w-full h-[350px] shadow-lg border border-slate-100"
      />
    </div>
  </section>

  <section class="grid md:grid-cols-3 gap-8 mb-24">
    <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
      <div>
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl">👥</div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Kader Penggerak</h3>
        <p class="text-slate-500 text-sm mb-6">Generasi muda dan tokoh adat yang dilatih untuk memimpin pergerakan di tingkat komunitas.</p>
      </div>
      <div class="flex items-center justify-between border-t border-slate-50 pt-4">
        <span class="text-3xl font-black text-green-700">{totalKader} <span class="text-sm font-medium text-slate-400">Jiwa</span></span>
        <a href="/kader" class="text-sm font-bold text-green-600 hover:text-green-700 inline-flex items-center gap-1 group">
          Detail Kader <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
      <div>
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl">🏡</div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Komunitas Adat</h3>
        <p class="text-slate-500 text-sm mb-6">Wilayah persebaran komunitas adat Mentawai yang telah terpetakan dan berdaulat.</p>
      </div>
      <div class="flex items-center justify-between border-t border-slate-50 pt-4">
        <span class="text-3xl font-black text-green-700">{totalKomunitas} <span class="text-sm font-medium text-slate-400">Wilayah</span></span>
        <a href="/komunitas" class="text-sm font-bold text-green-600 hover:text-green-700 inline-flex items-center gap-1 group">
          Jelajahi <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
      <div>
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl">📰</div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Kabar Terkini</h3>
        <p class="text-slate-500 text-sm mb-6">Informasi, advokasi kebijakan, dan rilis pers resmi seputar isu adat di Kepulauan Mentawai.</p>
      </div>
      <div class="flex items-center justify-between border-t border-slate-50 pt-4">
        <span class="text-sm font-medium text-slate-400">Update berkala</span>
        <a href="/berita" class="text-sm font-bold text-green-600 hover:text-green-700 inline-flex items-center gap-1 group">
          Baca Berita <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white p-8 md:p-12 rounded-3xl border border-slate-100 shadow-sm mb-24">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-10 gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-slate-900 flex items-center gap-2">
          <span class="w-2 h-8 bg-green-500 rounded-full"></span>
          Agenda & Kegiatan Terbaru
        </h2>
        <p class="text-slate-500 mt-1">Aktivitas riil AMAN Mentawai di lapangan bersama masyarakat adat.</p>
      </div>
      <a href="/kegiatan" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-6 py-3 rounded-full text-sm transition-all text-center">
        Semua Kegiatan
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {kegiatanDitampilkan.map((kegiatan) => (
        <div class="flex flex-col justify-between h-full bg-slate-50 p-6 rounded-2xl border border-slate-100 group hover:bg-white hover:shadow-lg hover:border-green-100 transition-all">
          <div>
            <span class="text-xs font-bold text-green-600 bg-green-50 px-3 py-1 rounded-full inline-block mb-4">Kegiatan</span>
            <h3 class="text-lg font-bold text-slate-800 mb-2 line-clamp-2 group-hover:text-green-700 transition-colors">
              {kegiatan.judul}
            </h3>
            <div class="text-slate-500 text-sm mb-4 line-clamp-3" set:html={kegiatan.deskripsi}></div>
          </div>
          <a href="/kegiatan" class="text-sm font-bold text-green-600 hover:underline inline-flex items-center gap-1 mt-4">
            Lihat Detail <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-24">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-slate-900">Suara Masyarakat Adat</h2>
      <p class="text-slate-500 mt-2 max-w-xl mx-auto">Dampak nyata dan harapan yang dirasakan langsung oleh masyarakat adat di tapak pergerakan.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimoniDitampilkan.map((testimoni) => {
        const inisial = testimoni.nama ? testimoni.nama.charAt(0).toUpperCase() : "A";
        return (
          <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm relative">
            <span class="text-6xl text-slate-100 font-serif absolute top-4 left-4 pointer-events-none">“</span>
            <div class="text-slate-600 italic relative z-10 mb-6 line-clamp-4" set:html={testimoni.kutipan}></div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-green-700 rounded-full flex items-center justify-center text-white font-bold text-sm">
                {inisial}
              </div>
              <div>
                <h4 class="font-bold text-slate-800 text-sm">{testimoni.nama}</h4>
                <p class="text-xs text-slate-400">{testimoni.peran}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-10 flex justify-center">
      <button id="btn-buka-testimoni" class="bg-green-50 text-green-600 hover:bg-green-100 border border-green-200 px-8 py-3 rounded-full font-bold text-sm transition-colors flex items-center gap-2 shadow-sm">
        <span>💬</span> Lihat Semua Kutipan
      </button>
    </div>
  </section>

  <div id="modal-testimoni" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white rounded-[2rem] max-w-4xl w-full shadow-2xl relative max-h-[90vh] flex flex-col overflow-hidden">
      
      <div class="flex items-center justify-between p-6 border-b border-slate-100 bg-white z-10 shadow-sm">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Kumpulan Suara Masyarakat</h2>
          <p class="text-sm text-slate-500">Mendengar langsung dari tapak pergerakan</p>
        </div>
        <button id="btn-tutup-testimoni" class="text-slate-400 hover:text-slate-700 font-bold text-xl cursor-pointer bg-slate-100 hover:bg-slate-200 w-10 h-10 rounded-full flex items-center justify-center transition-colors">✕</button>
      </div>

      <div class="p-6 md:p-8 overflow-y-auto flex-grow bg-slate-50">
        <div class="grid md:grid-cols-2 gap-6">
          {semuaTestimoni.length > 0 ? (
            semuaTestimoni.map((testimoni) => {
              const inisial = testimoni.nama ? testimoni.nama.charAt(0).toUpperCase() : "A";
              return (
                <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm relative hover:shadow-md transition-shadow">
                  <span class="text-5xl text-slate-100 font-serif absolute top-2 left-4 pointer-events-none">“</span>
                  <div class="text-slate-600 italic relative z-10 mb-6 text-sm leading-relaxed" set:html={testimoni.kutipan}></div>
                  <div class="flex items-center gap-3 mt-auto">
                    <div class="w-10 h-10 bg-green-700 rounded-full flex items-center justify-center text-white font-bold text-sm">
                      {inisial}
                    </div>
                    <div>
                      <h4 class="font-bold text-slate-800 text-sm">{testimoni.nama}</h4>
                      <p class="text-xs text-slate-400">{testimoni.peran}</p>
                    </div>
                  </div>
                </div>
              )
            })
          ) : (
             <div class="col-span-2 text-center text-slate-400 py-10">
               Belum ada data testimoni lainnya.
             </div>
          )}
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const modalTestimoni = document.getElementById('modal-testimoni');
  const btnBuka = document.getElementById('btn-buka-testimoni');
  const btnTutup = document.getElementById('btn-tutup-testimoni');

  btnBuka?.addEventListener('click', () => {
    modalTestimoni?.classList.remove('hidden');
    modalTestimoni?.classList.add('flex');
  });

  btnTutup?.addEventListener('click', () => {
    modalTestimoni?.classList.add('hidden');
    modalTestimoni?.classList.remove('flex');
  });

  modalTestimoni?.addEventListener('click', (e) => {
    if (e.target === modalTestimoni) {
      modalTestimoni?.classList.add('hidden');
      modalTestimoni?.classList.remove('flex');
    }
  });
</script>