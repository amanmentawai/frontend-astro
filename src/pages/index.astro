---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Beranda | AMAN Mentawai">
  <section class="relative h-[80vh] w-full rounded-3xl overflow-hidden mb-16 shadow-2xl">
    <img 
      src="/images/hero-mentawai.jpg" 
      class="absolute inset-0 w-full h-full object-cover"
      alt="Masyarakat Adat Mentawai"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent flex items-center px-12">
      <div class="max-w-2xl text-white">
        <h1 class="text-6xl font-bold mb-6 leading-tight">AMAN <span class="text-green-400">Mentawai</span></h1>
        <p class="text-xl text-slate-200 mb-8 leading-relaxed">
          Aliansi Masyarakat Adat Nusantara. Berjuang untuk kedaulatan politik, kemandirian ekonomi, dan martabat budaya masyarakat adat Mentawai.
        </p>
        <div class="flex gap-4">
            <a href="/profil" class="bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-full font-bold transition">Profile</a>
            <a href="/dokumen" class="bg-white/20 hover:bg-white/30 backdrop-blur-md text-white border border-white/40 px-8 py-3 rounded-full font-bold transition">Dokumen</a>
        </div>
      </div>
    </div>
  </section>

  <div class="grid md:grid-cols-3 gap-8 mb-20">
    <div class="md:col-span-2 space-y-6">
        <h2 class="text-3xl font-bold text-slate-800 flex items-center gap-2">
            <span class="w-2 h-8 bg-green-500 rounded-full"></span>
            Tentang Kami
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
            Mewujudkan masyarakat adat Mentawai yang berdaulat secara politik, mandiri secara ekonomi, dan bermartabat secara budaya. Kami terus melakukan pendampingan komunitas, penguatan kader, dan perlindungan wilayah adat.
        </p>
    </div>

    <div class="bg-green-800 rounded-3xl p-8 text-white flex flex-col justify-center shadow-xl">
        <div class="text-4xl font-bold mb-2">10+</div>
        <div class="text-green-300 font-medium">Komunitas Adat Terdaftar</div>
    </div>
  </div>

  <section class="grid md:grid-cols-3 gap-6">
    <div class="group bg-white p-8 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-green-200 transition-all cursor-pointer">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-green-600 group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">Pendidikan Adat</h3>
        <p class="text-slate-500">Mentransfer kearifan lokal Mentawai kepada generasi muda agar tidak punah ditelan zaman.</p>
    </div>
    
    </section>
</MainLayout>