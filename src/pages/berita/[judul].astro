---
import MainLayout from '../../layouts/MainLayout.astro';
import { directus, getDirectusAsset } from '../../lib/directus';
import { readItems } from '@directus/sdk';

export const prerender = false;

const { judul } = Astro.params;

let berita = null;
let urlFoto = null;
let formatWaktu = 'Waktu tidak diketahui';

try {
  const response = await directus.request(
    readItems('artikel_berita', {
      filter: {
        judul: {
          _eq: decodeURIComponent(judul)
        }
      },
      limit: 1
    })
  );

  if (response && response.length > 0) {
    berita = response[0];
    
    // Setup Gambar Utama
    if (berita.gambar_utama) {
      const fotoId = typeof berita.gambar_utama === 'object' ? berita.gambar_utama.id : berita.gambar_utama;
      urlFoto = getDirectusAsset(fotoId);
    }

    // Setup Format Waktu
    if (berita.tanggal_publikasi) {
      const dateObj = new Date(berita.tanggal_publikasi);
      formatWaktu = dateObj.toLocaleDateString('id-ID', {
        timeZone: 'Asia/Jakarta',
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
    }
  } else {
    return Astro.redirect('/berita');
  }
} catch (error) {
  console.error("Gagal mengambil detail Berita berdasarkan judul:", error);
  return Astro.redirect('/berita');
}

const judulAman = berita?.judul || 'Tanpa Judul';
const kontenHtml = berita?.konten || '<p>Tidak ada konten.</p>';
---

<MainLayout title={`${judulAman} | AMAN Mentawai`}>
  <div class="max-w-5xl mx-auto py-10 px-4 md:px-8">
    
    <a href="/berita" class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-green-600 transition-colors mb-8">
      <span>←</span> Kembali ke Pusat Informasi
    </a>

    <header class="mb-8">
      <span class="text-[10px] font-bold uppercase tracking-widest text-green-600 bg-green-50 px-3 py-1 rounded-full inline-block mb-4">Artikel Berita</span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight mb-4">{judulAman}</h1>
      <div class="text-sm font-medium text-slate-400">
        Dipublikasikan pada: <span class="text-slate-600">{formatWaktu}</span>
      </div>
    </header>

    {urlFoto && (
      <div id="wrapper-gambar-utama" class="w-full rounded-3xl overflow-hidden mb-10 border border-slate-100 shadow-sm relative group cursor-pointer bg-slate-50">
        <img id="gambar-utama" src={urlFoto} alt={judulAman} class="w-full h-auto max-h-[550px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.01]" />
        <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <span class="bg-white/20 backdrop-blur-md text-white font-bold px-5 py-2.5 rounded-full flex items-center gap-2 shadow-lg text-sm">
             Klik untuk memperbesar gambar
          </span>
        </div>
      </div>
    )}

    <article class="format-berita bg-white p-6 md:p-12 rounded-3xl border border-slate-100 shadow-sm">
      <div set:html={kontenHtml}></div>
      
      {berita.link_eksternal && (
        <div class="mt-8 pt-6 border-t border-slate-100">
          <a href={berita.link_eksternal} target="_blank" class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-slate-800 hover:bg-slate-900 text-white text-sm font-bold px-6 py-3 rounded-xl transition-colors no-underline">
            Kunjungi Sumber Artikel / Link Terkait
          </a>
        </div>
      )}
    </article>
  </div>

  <div id="modal-zoom" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/95 backdrop-blur-sm transition-opacity">
    <button id="close-zoom" class="absolute top-6 right-6 text-white/70 hover:text-white text-4xl focus:outline-none z-[120] transition-colors w-12 h-12 flex items-center justify-center bg-white/10 hover:bg-white/20 rounded-full">&times;</button>
    
    <div id="zoom-container" class="w-full h-full flex items-center justify-center overflow-auto p-4 relative">
      <img id="gambar-zoom" src="" alt="Zoomed" class="max-w-full max-h-full object-contain transition-transform duration-300 origin-center" style="transform: scale(1);" />
    </div>

    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex items-center gap-4 bg-white/10 px-6 py-3 rounded-full backdrop-blur-md border border-white/20 z-[120] shadow-2xl">
      <button id="btn-zoom-out" class="text-white hover:text-green-400 text-3xl font-bold focus:outline-none w-10 h-10 flex items-center justify-center transition-colors">&minus;</button>
      <span class="text-white/80 text-sm font-bold px-2 w-16 text-center" id="zoom-level">100%</span>
      <button id="btn-zoom-in" class="text-white hover:text-green-400 text-3xl font-bold focus:outline-none w-10 h-10 flex items-center justify-center transition-colors">&plus;</button>
    </div>
  </div>
</MainLayout>

<style is:global>
  .format-berita {
    color: #334155; 
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .format-berita h1 { font-size: 2rem; font-weight: 900; color: #0f172a; margin-top: 2rem; margin-bottom: 1rem; }
  .format-berita h2 { font-size: 1.6rem; font-weight: 700; color: #1e293b; margin-top: 2rem; margin-bottom: 1rem; }
  .format-berita h3 { font-size: 1.35rem; font-weight: 700; color: #1e293b; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .format-berita p { margin-bottom: 1.5rem; text-align: justify; }
  .format-berita b, .format-berita strong { font-weight: 700; color: #0f172a; }
  .format-berita i, .format-berita em { font-style: italic; }
  .format-berita u { text-decoration: underline; text-decoration-color: #cbd5e1; text-underline-offset: 2px; }
  .format-berita ul { list-style-type: disc; list-style-position: outside; padding-left: 1.5rem; margin-bottom: 1.5rem; }
  .format-berita ol { list-style-type: decimal; list-style-position: outside; padding-left: 1.5rem; margin-bottom: 1.5rem; }
  .format-berita li { margin-bottom: 0.5rem; }
  .format-berita a { color: #16a34a; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .format-berita img { border-radius: 1rem; width: 100%; height: auto; margin: 2rem 0; border: 1px solid #f1f5f9; }
  .format-berita blockquote { border-left: 4px solid #22c55e; background-color: rgba(240, 253, 244, 0.5); padding: 1rem; margin: 2rem 0; font-style: italic; color: #475569; border-radius: 0 0.5rem 0.5rem 0; }
</style>

<script>
  const wrapperGambar = document.getElementById('wrapper-gambar-utama');
  const gambarUtama = document.getElementById('gambar-utama') as HTMLImageElement;
  const modalZoom = document.getElementById('modal-zoom');
  const gambarZoom = document.getElementById('gambar-zoom') as HTMLImageElement;
  const closeZoom = document.getElementById('close-zoom');
  const btnZoomIn = document.getElementById('btn-zoom-in');
  const btnZoomOut = document.getElementById('btn-zoom-out');
  const txtZoomLevel = document.getElementById('zoom-level');

  let currentScale = 1;

  function setZoom() {
    if (gambarZoom) gambarZoom.style.transform = `scale(${currentScale})`;
    if (txtZoomLevel) txtZoomLevel.textContent = `${Math.round(currentScale * 100)}%`;
  }

  wrapperGambar?.addEventListener('click', () => {
    if (!gambarUtama || !gambarUtama.src) return;
    if (gambarZoom) gambarZoom.src = gambarUtama.src;
    currentScale = 1;
    setZoom();
    modalZoom?.classList.remove('hidden');
    modalZoom?.classList.add('flex');
  });

  closeZoom?.addEventListener('click', () => {
    modalZoom?.classList.add('hidden');
    modalZoom?.classList.remove('flex');
  });

  modalZoom?.addEventListener('click', (e) => {
    if (e.target === modalZoom || e.target === document.getElementById('zoom-container')) {
      modalZoom?.classList.add('hidden');
      modalZoom?.classList.remove('flex');
    }
  });

  btnZoomIn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentScale < 3) {
      currentScale += 0.25;
      setZoom();
    }
  });

  btnZoomOut?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentScale > 0.5) {
      currentScale -= 0.25;
      setZoom();
    }
  });
</script>