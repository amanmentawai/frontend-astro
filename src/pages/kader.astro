---
import MainLayout from '../layouts/MainLayout.astro';
import { directus } from '../lib/directus';
import { readItems } from '@directus/sdk';

export const prerender = false; 

let daftarKader = [];

try {
  // 1. Ambil data dasar semua kader terlebih dahulu
  const semuaKader = await directus.request(
    readItems('kader', {
      fields: ['id', 'nama', 'jenis_kelamin', 'usia', 'jabatan', 'komunitas_id.nama_kampung'],
      sort: ['nama'],
      limit: -1
    })
  );

  // 2. Ambil seluruh data junction yang menghubungkan kegiatan dan kader
  const seluruhJunction = await directus.request(
    readItems('kegiatan_kader', {
      fields: ['kader_id', 'kegiatan_id.*'],
      limit: -1
    })
  );

  // 3. Gabungkan data kegiatan ke masing-masing kader secara manual di memori
  daftarKader = semuaKader.map(kader => {
    // Cari kegiatan apa saja yang menyangkut ID kader ini
    const listKegiatanMilikKader = seluruhJunction
      .filter(junc => {
        // Antisipasi jika kader_id berupa objek atau langsung angka ID
        const idKaderJunction = typeof junc.kader_id === 'object' ? junc.kader_id?.id : junc.kader_id;
        return Number(idKaderJunction) === Number(kader.id);
      })
      .map(junc => junc.kegiatan_id) // Ambil data objek kegiatan utamanya
      .filter(Boolean);

    return {
      ...kader,
      list_kegiatan: listKegiatanMilikKader
    };
  });

} catch (error) {
  console.error("Gagal memproses data kombinasi Kader & Kegiatan:", error);
}

const komunitasUnik = [...new Set(daftarKader
  .filter(k => k.komunitas_id?.nama_kampung)
  .map(k => k.komunitas_id.nama_kampung)
)].sort();
---

<MainLayout 
  title="Direktori Kader Penggerak | AMAN Mentawai"
  description="Daftar lengkap profil, wilayah adat, jabatan, dan rekam jejak kontribusi kegiatan seluruh kader penggerak Aliansi Masyarakat Adat Nusantara (AMAN) di Mentawai."
>
  <header class="mb-8">
    <span class="text-xs font-bold uppercase tracking-widest text-green-600 bg-green-50 px-3 py-1 rounded-full inline-block mb-3">Sumber Daya Manusia</span>
    <h1 class="text-4xl font-black text-slate-900 tracking-tight">Direktori Kader Penggerak</h1>
  </header>

  <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm mb-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      
      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1.5 tracking-wider">Cari Nama Kader</label>
        <input
          type="text"
          id="search-kader"
          placeholder="Ketik nama untuk mencari..."
          class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:bg-white transition-all"
        />
      </div>

      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1.5 tracking-wider">Filter Komunitas</label>
        <select
          id="filter-komunitas"
          class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 cursor-pointer font-medium focus:outline-none focus:border-green-500"
        >
          <option value="">Semua Komunitas</option>
          {komunitasUnik.map(komunitas => (
            <option value={komunitas}>{komunitas}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1.5 tracking-wider">Urutan Data</label>
        <select
          id="sort-kader"
          class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 cursor-pointer font-medium focus:outline-none focus:border-green-500"
        >
          <option value="default">Default (Bawaan)</option>
          <option value="az">Nama (A ke Z)</option>
          <option value="za">Nama (Z ke A)</option>
          <option value="usia-muda">Usia (Termuda)</option>
          <option value="usia-tua">Usia (Tertua)</option>
          <option value="komunitas">Berdasarkan Komunitas</option>
        </select>
      </div>

    </div>
  </div>

  <div class="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden mb-10">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50/50">
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Nama</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Usia</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Komunitas</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Jabatan Tugas</th>
            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="tbody-kader">
          {daftarKader.map((kader) => {
            const asalKomunitas = kader.komunitas_id?.nama_kampung || 'Belum Ditentukan';
            // Mengekstrak array kegiatan milik kader tersebut
            const listKegiatan = kader.list_kegiatan || [];

            return (
              <tr 
                class="kader-row border-b border-slate-50 hover:bg-slate-50/70 transition-colors"
                data-nama={kader.nama}
                data-komunitas={asalKomunitas}
                data-usia={kader.usia}
              >
                <td class="px-6 py-4.5 font-bold text-slate-900">{kader.nama}</td>
                <td class="px-6 py-4.5 text-slate-600 text-sm">{kader.usia ? `${kader.usia} Tahun` : '-'}</td>
                <td class="px-6 py-4.5">
                  <span class="bg-green-50 text-green-700 text-xs font-semibold px-3 py-1 rounded-full border border-green-100/30">
                    {asalKomunitas}
                  </span>
                </td>
                <td class="px-6 py-4.5 text-slate-500 text-sm font-medium">{kader.jabatan || '-'}</td>
                <td class="px-6 py-4.5 text-right">
                  <button
                    class="btn-kegiatan-kader text-xs font-bold text-green-600 hover:text-green-700 cursor-pointer bg-green-50 hover:bg-green-100 px-3 py-1.5 rounded-xl transition-colors"
                    data-nama={kader.nama}
                    data-kegiatan={JSON.stringify(listKegiatan)}
                  >
                    Lihat Kegiatan →
                  </button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div id="kader-kosong" class="hidden text-center py-16 text-slate-400 font-medium border-t border-slate-50">
      <p>🕊️ Tidak ada data kader yang cocok dengan filter pencarian.</p>
    </div>
  </div>

  <div id="modal-kegiatan" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-[2rem] max-w-md w-full p-6 shadow-2xl relative max-h-[80vh] overflow-y-auto flex flex-col">
      <button id="close-modal-kegiatan" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600 font-bold text-lg cursor-pointer bg-slate-100 w-8 h-8 rounded-full flex items-center justify-center">✕</button>
      
      <div class="space-y-4 mt-2">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-green-600 bg-green-50 px-2.5 py-1 rounded-md inline-block mb-1">Rekam Jejak</span>
          <h2 class="text-2xl font-black text-slate-900 leading-tight">Riwayat Kegiatan</h2>
          <p class="text-slate-400 text-xs mt-0.5 font-medium">Kader: <span id="modal-nama-kader" class="text-slate-700 font-bold"></span></p>
        </div>
        
        <div id="modal-list-kegiatan" class="space-y-2 overflow-y-auto pr-1 max-h-96">
          </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const searchInput = document.getElementById('search-kader') as HTMLInputElement;
  const filterKomunitas = document.getElementById('filter-komunitas') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-kader') as HTMLSelectElement;
  const tbody = document.getElementById('tbody-kader');
  const pesanKosong = document.getElementById('kader-kosong');
  
  // Variabel untuk modal pop-up
  const modal = document.getElementById('modal-kegiatan');
  const closeModalBtn = document.getElementById('close-modal-kegiatan');
  const listKegiatanContainer = document.getElementById('modal-list-kegiatan');
  const modalNamaKader = document.getElementById('modal-nama-kader');
  
  let rows = Array.from(document.querySelectorAll('.kader-row')) as HTMLElement[];

  function filterKader() {
    const kataKunci = searchInput.value.toLowerCase().trim();
    const komunitasTerpilih = filterKomunitas.value;
    let adaData = false;

    rows.forEach(row => {
      const nama = (row.dataset.nama || '').toLowerCase();
      const komunitas = row.dataset.komunitas || '';

      const cocokKata = nama.includes(kataKunci);
      const cocokKomunitas = komunitasTerpilih === '' || komunitas === komunitasTerpilih;

      if (cocokKata && cocokKomunitas) {
        row.classList.remove('hidden');
        adaData = true;
      } else {
        row.classList.add('hidden');
      }
    });

    pesanKosong?.classList.toggle('hidden', adaData);
  }

  function urutkanKader() {
    const aturanUrutan = sortSelect.value;

    const rowsTerurut = rows.sort((a, b) => {
      const namaA = (a.dataset.nama || '').toLowerCase();
      const namaB = (b.dataset.nama || '').toLowerCase();
      const usiaA = parseInt(a.dataset.usia || '0', 10);
      const usiaB = parseInt(b.dataset.usia || '0', 10);
      const komA = (a.dataset.komunitas || '').toLowerCase();
      const komB = (b.dataset.komunitas || '').toLowerCase();

      switch (aturanUrutan) {
        case 'az': return namaA.localeCompare(namaB);
        case 'za': return namaB.localeCompare(namaA);
        case 'usia-muda': return (isNaN(usiaA) ? 999 : usiaA) - (isNaN(usiaB) ? 999 : usiaB);
        case 'usia-tua': return (isNaN(usiaB) ? -1 : usiaB) - (isNaN(usiaA) ? -1 : usiaA);
        case 'komunitas': return komA.localeCompare(komB);
        default: return 0;
      }
    });

    tbody!.innerHTML = '';
    rowsTerurut.forEach(row => tbody!.appendChild(row));
    filterKader();
  }

  // 🟢 LOGIK POP-UP MODAL (Menggunakan Event Delegation agar tetap berfungsi walau data di-sort/di-filter)
  tbody?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.btn-kegiatan-kader') as HTMLElement | null;
    if (!target) return;

    // Pasang nama kader di header modal
    if (modalNamaKader) modalNamaKader.textContent = target.dataset.nama || '';
    
    // Ambil data array kegiatan dari data-attribute HTML
    const listKegiatan = JSON.parse(target.dataset.kegiatan || '[]');
    if (listKegiatanContainer) listKegiatanContainer.innerHTML = '';

    if (listKegiatan.length === 0) {
      listKegiatanContainer!.innerHTML = `
        <div class="text-center py-8 text-xs text-slate-400 font-medium italic bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          🌱 Kader ini belum terdaftar di kegiatan manapun saat ini.
        </div>`;
    } else {
      listKegiatan.forEach((keg: any) => {
        const itemKegiatan = document.createElement('div');
        itemKegiatan.className = "p-3.5 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-100 transition-colors text-left";
        
        const opsiTanggal: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
        const tanggalFormat = keg.tanggal_waktu ? new Date(keg.tanggal_waktu).toLocaleDateString('id-ID', opsiTanggal) : 'Tanggal tidak diset';

        itemKegiatan.innerHTML = `
          <p class="font-bold text-slate-800 text-sm"> ${keg.judul || 'Kegiatan Tanpa Judul'}</p>
          <p class="text-[11px] text-slate-400 font-medium mt-1"> ${tanggalFormat}</p>
        `;
        listKegiatanContainer?.appendChild(itemKegiatan);
      });
    }

    // Tampilkan Modal
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  // Event Listener untuk menutup modal
  closeModalBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }
  });

  searchInput?.addEventListener('input', filterKader);
  filterKomunitas?.addEventListener('change', filterKader);
  sortSelect?.addEventListener('change', urutkanKader);
</script>